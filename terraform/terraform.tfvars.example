# AWS Region
aws_region = "us-east-1"

# Existing EC2 Key Pair in your AWS account
key_pair_name = "my-aws-key"

# Local path to your private key (.pem file)
private_key_file = "~/.ssh/my-aws-key.pem"

# Recommended: Lock down SSH and K8s API port to your own IP address
ssh_allowed_cidr = "0.0.0.0/0"

# Instance type (t2.micro or t3.micro for Free Tier)
instance_type = "t2.micro"
