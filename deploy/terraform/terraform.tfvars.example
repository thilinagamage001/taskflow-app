# Azure Resource Settings
resource_group_name = "rg-taskflow-prod"
location            = "eastus"

# Free Tier VM Settings
vm_name             = "vm-taskflow"
vm_size             = "Standard_B1s" # Free tier eligible for 12 months
admin_username      = "azureuser"

# SSH Key Settings (Adjust if using ~/.ssh/id_ed25519)
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"
